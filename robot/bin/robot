#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
PACKAGE_ROOT="$(cd -- "${SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd)"

if [[ ! -f "${PACKAGE_ROOT}/dist/index.js" ]]; then
  npm --prefix "${PACKAGE_ROOT}" run build
fi

exec node "${PACKAGE_ROOT}/dist/index.js" "$@"
